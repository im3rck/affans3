# Gemini API Configuration
GOOGLE_API_KEY=your_gemini_api_key_here

# Model Configuration
# Use gemini-1.5-flash-latest for higher free tier rate limits (15 req/min vs 2 req/min for pro)
GEMINI_MODEL=gemini-1.5-flash-latest
EMBEDDING_MODEL=models/embedding-001

# RAG Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5
RERANK_TOP_K=3

# Vector Database
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Application
DEBUG=False
